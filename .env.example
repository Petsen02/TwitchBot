# ---- Riot ----------------------------------------------------------------
# Personal API key from https://developer.riotgames.com (never commit this)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Region used for channels that have not set their own with !oldregion.
# Each channel keeps its own, so mixed regions are fine.
RIOT_PLATFORM=euw1

# Personal key allowance. The two-minute window is the binding one, and is
# budgeted per region. Raise both only with a production key.
RIOT_LIMIT_PER_SECOND=20
RIOT_LIMIT_PER_TWO_MINUTES=100

# ---- Twitch --------------------------------------------------------------
TWITCH_BOT_USERNAME=yourbotaccount
# With or without the "oauth:" prefix
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Channels to join, comma separated. Rosters are managed in chat, not here.
# Listing a channel that was removed with !oldleave brings it back.
TWITCH_CHANNELS=yourchannel

# Your own Twitch login. Lets you remove the bot from any channel with
# !oldleave <channel>, without being a moderator there.
BOT_OWNER=yourlogin

# ---- First-run seed ------------------------------------------------------
# Copied into the FIRST channel the very first time the bot starts, and
# ignored once that channel has a roster. Everything after that is managed
# with !oldaddplayer / !oldaddmain.
PLAYERS=
DEFAULT_RIOT_ID=

# ---- Appearance ----------------------------------------------------------
# How ranks are written in chat. Defaults to emotes.
#   letters = "E4 77LP"
#   emotes  = "EMERALD IV: 77LP", swapped for 7TV channel emotes named after
#             each tier. 7TV is case sensitive: the emotes must be named
#             IRON, BRONZE, SILVER, GOLD, PLATINUM, EMERALD, DIAMOND,
#             MASTER, GRANDMASTER, CHALLENGER. Viewers without the 7TV
#             extension see the tier name as plain text.
RANK_STYLE=emotes

# Show a ladder position (Rank#167) only for players this high or better.
LADDER_POSITION_LIMIT=250

# ---- Timing --------------------------------------------------------------
# Where !oldcommands sends people.
WIKI_URL=https://github.com/Petsen02/TwitchBot

TIMEZONE=Europe/Copenhagen

# Cutoffs refresh on fixed clock boundaries, not a rolling timer, so everyone
# in chat sees the same figure. 1440 = once a day at local midnight,
# 60 = on the hour, 30 = :00 and :30.
CUTOFF_REFRESH_MINUTES=1440

# Accounts that are playing are polled often; idle ones back off hard. This is
# what makes many channels affordable on a personal key.
ACTIVE_POLL_SECONDS=60
IDLE_POLL_SECONDS=600
ACTIVE_WINDOW_MINUTES=45

RANK_CACHE_SECONDS=60
COMMAND_COOLDOWN_SECONDS=5
